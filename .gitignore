*.log
.DS_Store
.env
.env.backup
# Cualquier copia del .env, con el sufijo que sea. El patron exacto
# '.env.backup' dejaba pasar '.env.backup-antes-de-app-url', que se colo
# en un commit con APP_KEY y credenciales dentro.
.env.backup*
.env.*.backup
.env.production
.phpactor.json
.phpunit.result.cache
/.fleet
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
Homestead.json
Homestead.yaml
Thumbs.db

# --- ERA Realty ---
# Lo que suben los administradores en produccion NO se versiona; se respalda
# aparte (docs/09_DEPLOYMENT.md seccion 5).
/storage/app/public/news/*
/storage/app/public/agents/*
/storage/app/public/settings/*
/storage/app/public/media/*
!/storage/app/public/*/.gitkeep

# EXCEPCION: las fotos del catalogo de demostracion SI se versionan.
#
# Son las que importa `era:import` del sitio anterior, y van con
# database/data/properties.json para que quien clone el repositorio tenga un
# catalogo real sin depender de que erarealtyrd.com siga en pie.
#
# Pesan unos 49 MB. Si algun dia molestan, se quitan de aqui y se regeneran
# con `php artisan era:import --force`.

# Respaldos locales de configuracion de PHP/Apache
*.bak-*

# El diseno de Stitch SI se versiona: es la referencia visual del proyecto.
# No anadir stitch_era_realty_rd_premium_redesign/ aqui.
