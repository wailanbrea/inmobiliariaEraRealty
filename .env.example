APP_NAME="ERA Realty RD"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://era-realty.test

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/Santo_Domingo

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=era_realty
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=database

# --- Correo ---
# En local no se envia correo real: se escribe en storage/logs/laravel.log
# La configuracion SMTP real se gestiona desde /admin/configuracion/correo
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@erarealtyrd.com"
MAIL_FROM_NAME="${APP_NAME}"
CONTACT_FORM_RECIPIENT="info@erarealtyrd.com"

# --- Moneda ---
# El sitio opera en USD y DOP. Tasa editable desde el panel;
# este valor solo se usa como semilla inicial.
CURRENCY_DEFAULT=USD
CURRENCY_USD_TO_DOP=60.50

VITE_APP_NAME="${APP_NAME}"

# Correo del super_admin que crea AdminUserSeeder.
# La contrasena se genera aleatoria y se muestra una sola vez en consola.
ADMIN_EMAIL=admin@erarealtyrd.com
